{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Chạy web quản trị",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev", "--", "--open"],
      "options": { "cwd": "${workspaceFolder}/web-admin" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Build web quản trị",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}/web-admin" },
      "problemMatcher": []
    },
    {
      "label": "Xem bản build web quản trị",
      "type": "shell",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "preview", "--", "--open"],
      "options": { "cwd": "${workspaceFolder}/web-admin" },
      "problemMatcher": [],
      "isBackground": true,
      "dependsOn": "Build web quản trị"
    }
  ]
}
