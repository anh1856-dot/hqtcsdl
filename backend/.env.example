# Copy file nay thanh .env roi sua cho phu hop may minh:  copy .env.example .env

PORT=3000

# ---- SQL Server ----
# SQL Server can bat TCP/IP va che do "SQL Server and Windows Authentication"
DB_SERVER=localhost
DB_PORT=1433
# Neu cai ban Express (localhost\SQLEXPRESS): DB_INSTANCE=SQLEXPRESS va bo trong DB_PORT
DB_INSTANCE=
DB_NAME=MushroomFarmDB
# Login tao boi database/05_security.sql (chi dung tren may dev)
DB_USER=mushroom_app
DB_PASSWORD=MushroomApp@Dev2026
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# ---- Xac thuc ----
# Doi thanh chuoi ngau nhien dai bat ky
JWT_SECRET=doi_chuoi_bi_mat_nay_thanh_chuoi_ngau_nhien
JWT_EXPIRES_IN=7d

# Khoa thiet bi IoT gui kem header x-device-key khi goi /api/sensors/*
IOT_DEVICE_KEY=dev-iot-key

# Cho phep web/app goi API (* = tat ca, hoac vd http://localhost:5173)
CORS_ORIGIN=*

# Tu dong dong don thue het han moi ngay
ENABLE_SCHEDULER=true
